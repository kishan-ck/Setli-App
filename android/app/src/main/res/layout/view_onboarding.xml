<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/onboardingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:clickable="true"
    android:fitsSystemWindows="true"
    android:focusable="true">

    <!-- Top Header Bar -->
    <RelativeLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_alignParentTop="true"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="24dp">

        <!-- Logo & Brand Name -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="84dp"
                android:layout_height="26dp"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/icon_setli" />
        </LinearLayout>

        <!-- Skip Button -->
        <TextView
            android:id="@+id/tvSkip"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="4dp"
            android:text="Skip"
            android:textColor="#6B8CAE"
            android:textSize="15sp"
            android:fontFamily="@font/plus_jakarta_sans_semi_bold"/>
    </RelativeLayout>

    <!-- Bottom Controls Container -->
    <LinearLayout
        android:id="@+id/layoutBottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:orientation="vertical">

        <!-- Primary Action Button ("Next  ›" / "Get Started  ›") -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnPrimaryAction"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_button_blue"
            android:elevation="4dp"
            android:stateListAnimator="@null"
            android:text="Next  ›"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:fontFamily="@font/plus_jakarta_sans_bold" />

        <!-- Secondary Row (Back button on left, custom pill dots in center) -->
        <RelativeLayout
            android:id="@+id/layoutSecondaryRow"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="12dp">

            <!-- Back Button -->
            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentStart="true"
                android:gravity="center_vertical"
                android:text="‹  Back"
                android:textColor="#6B7280"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="invisible" />

            <!-- Page Indicator Dots Container -->
            <LinearLayout
                android:id="@+id/layoutDots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:id="@+id/dot0"
                    android:layout_width="22dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_indicator_active" />

                <View
                    android:id="@+id/dot1"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_indicator_inactive" />

                <View
                    android:id="@+id/dot2"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_indicator_inactive" />

                <View
                    android:id="@+id/dot3"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_indicator_inactive" />

                <View
                    android:id="@+id/dot4"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/bg_indicator_inactive" />
            </LinearLayout>

        </RelativeLayout>

    </LinearLayout>

    <!-- ViewPager2 placed between Header and Bottom Controls -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/layoutBottomControls"
        android:layout_below="@+id/layoutHeader"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

</RelativeLayout>
